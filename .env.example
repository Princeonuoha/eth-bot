# ─── Binance Credentials ────────────────────────────────────────────────────
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# ─── Environment ─────────────────────────────────────────────────────────────
# Set to "true" to use Binance Spot Testnet (STRONGLY recommended first)
TESTNET=true

# ─── Strategy Parameters ─────────────────────────────────────────────────────
SYMBOL=ETHUSDC
TRADE_AMOUNT_USDC=100          # USDC to use per trade (not your full capital)
TAKE_PROFIT_PCT=1.0            # % gain to trigger sell
STOP_LOSS_PCT=0.7              # % loss to trigger sell
DAILY_LOSS_LIMIT_USDC=30       # Bot shuts down for the day if this is hit
RSI_OVERSOLD=38                # RSI threshold for entry signal
PULLBACK_MIN_PCT=0.8           # Min % drop from recent high before entry
LOOP_INTERVAL_SECONDS=30       # How often the bot polls

# ─── Notifications (optional) ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
